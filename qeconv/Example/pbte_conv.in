
&CONTROL
  calculation = 'scf'
  etot_conv_thr = 8.0d-05
  forc_conv_thr = 1.0d-04
  outdir = './out/'
  prefix = 'aiida'
  pseudo_dir = './pseudo/'
  tprnfor = .true.
  tstress = .true.
  verbosity = 'high'
/

&SYSTEM
  degauss = 2.0d-02
  ecutrho = 320
  ecutwfc = 40
  ibrav = 0
  nat = 8
  nosym = .false.
  ntyp = 2
  occupations = 'smearing'
  smearing = 'cold'
/

&ELECTRONS
  conv_thr = 1.6d-09
  electron_maxstep = 80
  mixing_beta = 0.4
/

&IONS
  ion_dynamics = 'bfgs'
/

&CELL
  cell_dynamics = 'bfgs'
/

ATOMIC_SPECIES
Pb  207.2  Pb.pbe-dn-kjpaw_psl.0.2.2.UPF
Te  127.6  Te_pbe_v1.uspp.F.UPF

ATOMIC_POSITIONS crystal
